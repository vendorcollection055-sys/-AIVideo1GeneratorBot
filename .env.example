# Copy this file to .env for local testing (never commit the real .env)

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# From https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Any Replicate model in "owner/model" format that accepts a text prompt
# and returns a video. Default below is a solid free starting point.
REPLICATE_MODEL=anotherjesse/zeroscope-v2-xl
